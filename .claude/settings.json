{
  "permissions": {
    "deny": [
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/.env)",
      "Read(**/.env.development)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/key.properties)",
      "Read(**/secrets.dart)"
    ],
    "allow": [
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/python *)",
      "Bash(python3 *)"
    ]
  }
}
